# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives (which insert the entries of the given .gitignore-style
# file at that point).
#
# For more information, run:
#   $ gcloud topic gcloudignore
#
.gcloudignore
# If you would like to upload your .git directory, .gitignore file or files
# from your .gitignore file, remove the corresponding line
# below:
.git
.gitignore

# Virtual environments
venv_2man/
venv/
.venv/

# Python pycache:
__pycache__/
# Ignored by the build system
/setup.cfg

# Ignore environment files
.env

/tmp
/archive_versions

#venv


#json_keys
/json_keys

logging/

# Archive folder (old/unused code)
/archive

# Dev tools not needed on server
gcloud_deploy.py
*.md

# Scratch — never ship (2026-09-02 fleet fix: _oneoff/ may hold ingested data with secrets)
_oneoff/

# Never runtime — local agent config, OS cruft, pre-edit backups, and the
# archive convention. Mirrors DEFAULT_UNSTAGE_PATTERNS in the shared deploy
# tool. Added 2026-09-04 after an archived MP4 in a gcloudignore-uncovered
# _antiquated dir stalled three deploys: the upload-hygiene gate only reads as
# a signal if its warn list is normally empty.
.DS_Store
.claude/
*.bak
_antiquated/
_antiquated_files/
*_antiquated*
gcloud_deploy.py
