{
  "project_id": "twomanspades",
  "app_name": "2ManSpades",
  "github_repo": "https://github.com/tillo13/2manspades.git",
  "shared_files": [
    {
      "src": "anthropic_logger/anthropic_logger.py",
      "dst": "utilities/anthropic_logger.py"
    },
    {
      "src": "kumori/shared/kumori_api_client/__init__.py",
      "dst": "utilities/kumori_api_client/__init__.py"
    },
    {
      "src": "kumori/shared/kumori_api_client/client.py",
      "dst": "utilities/kumori_api_client/client.py"
    },
    {
      "src": "schema_guard/schema_guard.py",
      "dst": "utilities/schema_guard.py"
    },
    {
      "src": "visitor_logging/visitor_logging.py",
      "dst": "utilities/visitor_logging.py"
    },
    {
      "src": "gtag/gtag.py",
      "dst": "utilities/gtag.py"
    },
    {
      "src": "kumori/utilities/postgres_utils/connection.py",
      "dst": "utilities/kumori_db.py"
    },
    {
      "src": "kumori/utilities/mail_guard.py",
      "dst": "utilities/mail_guard.py"
    },
    {
      "src": "kumori/utilities/gmail_utils.py",
      "dst": "utilities/kumori_gmail.py"
    }
  ],
  "cron_yaml": true,
  "cloud_run_jobs": [
    {
      "name": "twomanspades-crons",
      "dockerfile": "Dockerfile.crons",
      "timeout": "600s",
      "memory": "1Gi",
      "cpu": "1",
      "cloudsql_instances": [
        "kumori-404602:us-central1:kumori"
      ],
      "service_account": "twomanspades-crons@twomanspades.iam.gserviceaccount.com",
      "files": [
        "Dockerfile.crons",
        "requirements.txt",
        "utilities/",
        "tools/cloud_run_crons.py"
      ]
    }
  ],
  "pre_deploy_test": "venv_2man/bin/python -m unittest discover -s tests -q && /Users/at/Desktop/code/_local_infrastructure/anthropic_logger/check_violations.sh .",
  "post_deploy_test": "curl --fail --silent --show-error https://2manspades.com/health",
  "venv": "venv_2man"
}
